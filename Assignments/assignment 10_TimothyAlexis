      "source": [
        "# Calculate the profit from your model\n",
        "# True positives (predicted to answer, and did answer) contribute $75 profit\n",
        "# False positives (predicted to answer, but did not answer) result in -$25 cost\n",
        "\n",
        "# From the confusion matrix:\n",
        "# cm[1, 1] is True Positives (Actual Yes, Predicted Yes)\n",
        "# cm[0, 1] is False Positives (Actual No, Predicted Yes)\n",
